# ─────────────────────────────────────────────────────────
#  Monitoring You Environment Configuration
#  Copy this file, fill in your values, then run:
#    Windows:  set SMTP_USER=you@gmail.com && python app.py
#    Linux:    source config.env && python app.py
# ─────────────────────────────────────────────────────────

# ── EMAIL (Gmail) ─────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
# 4. Paste it below (16 chars, no spaces)

export SMTP_USER="your-email@gmail.com"
export SMTP_PASS="xxxx xxxx xxxx xxxx"
export SMTP_FROM="your-email@gmail.com"

# ── SMS via Twilio (optional) ─────────────────────────────
# Sign up free at https://www.twilio.com
# Get a trial phone number, then fill in:

export TWILIO_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export TWILIO_TOKEN="your_auth_token"
export TWILIO_FROM="+14155552671"

# ── Monitor settings ──────────────────────────────────────
export MONITOR_TOKEN="monitor-secret"
export POLL_INTERVAL="30"
